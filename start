#!/usr/bin/env bash

# initialize variables
DAEMON=bitcoinii
NETWORK=mainnet
FEATURES=default
DB_FOLDER="${HOME}/electrs-db"
NODENAME=$(hostname|cut -d . -f1)
USAGE="Usage: $0 (mainnet|testnet|regtest) [popular-scripts|version]"

# load rust if necessary
if [ -e "${HOME}/.cargo/env" ];then
	source "${HOME}/.cargo/env"
	export PATH="${HOME}/.cargo/bin:${PATH}"
fi

# which OS?
case "$(uname -s)" in
	FreeBSD)
		OS=FreeBSD
		NPROC=$(sysctl -n hw.ncpu)
	;;
	Darwin)
		OS=Darwin
		NPROC=$(sysctl -n hw.ncpu)
	;;
	Linux)
		OS=Linux
		NPROC=$(nproc 2>/dev/null || grep -c proc /proc/cpuinfo)
	;;
	*)
		OS=Unknown
		NPROC=4
	;;
esac

# which network?
case "${1}" in
	mainnet|"")
		NETWORK=mainnet
		THREADS=$((NPROC / 3))
		CRONJOB_TIMING="20 4 * * *"
	;;
	testnet)
		NETWORK=testnet
		THREADS=$((NPROC / 6))
		CRONJOB_TIMING="2 4 * * *"
	;;
	regtest)
		NETWORK=regtest
		THREADS=$((NPROC / 6))
		CRONJOB_TIMING="9 4 * * *"
	;;
	*)
		echo "${USAGE}"
		exit 1
	;;
esac

# Popular scripts configuration
POPULAR_SCRIPTS_FOLDER="${HOME}/popular-scripts/${NETWORK}"
POPULAR_SCRIPTS_FILE_RAW="${POPULAR_SCRIPTS_FOLDER}/popular-scripts-raw.txt"
POPULAR_SCRIPTS_FILE="${POPULAR_SCRIPTS_FOLDER}/popular-scripts.txt"

# Function to generate popular scripts text file
generate_popular_scripts() {
	mkdir -p "${POPULAR_SCRIPTS_FOLDER}"

	echo "[*] Generating popular-scripts using ${THREADS} threads..."
	cd "${HOME}/electrs.BitcoinII"
	
	HIGH_USAGE_THRESHOLD=101 \
	JOB_THREAD_COUNT=${THREADS} \
	nice cargo run \
		--release \
		--bin popular-scripts \
		--features "${FEATURES}" \
		-- \
		--network "${NETWORK}" \
		--db-dir "${DB_FOLDER}" \
		> "${POPULAR_SCRIPTS_FILE_RAW}" 2>&1

	# Only overwrite if successful
	if [ "$?" = "0" ];then
		echo "[*] Sorting popular scripts for final results..."
		sort "${POPULAR_SCRIPTS_FILE_RAW}" | uniq > "${POPULAR_SCRIPTS_FILE}"
		rm "${POPULAR_SCRIPTS_FILE_RAW}"
		echo "[*] Popular scripts generated: ${POPULAR_SCRIPTS_FILE}"
	else
		echo "[!] Failed to generate popular scripts"
		rm -f "${POPULAR_SCRIPTS_FILE_RAW}"
	fi
}

# Cronjob command for reference
CRONJOB_CMD="\"${HOME}/electrs.BitcoinII/start\" \"${NETWORK}\" popular-scripts"
echo "[*] Cronjob suggestion: ${CRONJOB_TIMING} ${CRONJOB_CMD}"

# Handle special commands
case "${2}" in
	popular-scripts)
		echo "[*] Only generate popular-scripts, then exit"
		generate_popular_scripts
		exit 0
	;;
	version)
		echo "[*] Only print versions, then exit"
		cd "${HOME}/electrs.BitcoinII"
		cargo run --bin electrs --release -- --version
		cargo run --bin popular-scripts --release -- --version 2>/dev/null
		exit 0
	;;
	"")
		# Normal operation
	;;
	*)
		echo "${USAGE}"
		exit 1
	;;
esac

# Run in loop in case of crash
until false
do
	# Reset CWD
	cd "${HOME}/electrs.BitcoinII"

	# Disable core dumps
	ulimit -c 0

	# Prepare run-time variables
	UTXOS_LIMIT=500
	ELECTRUM_TXS_LIMIT=500
	MAIN_LOOP_DELAY=500
	DAEMON_DIR="${HOME}/.BitcoinII"
	DAEMON_CONF="${DAEMON_DIR}/BitcoinII.conf"
	HTTP_SOCKET_FILE="${HOME}/socket/esplora-${DAEMON}-${NETWORK}"
	RPC_SOCKET_FILE="${HOME}/socket/electrum-${DAEMON}-${NETWORK}"

	# Create socket directory if it doesn't exist
	mkdir -p "$(dirname "${HTTP_SOCKET_FILE}")"

	# Get RPC credentials from BitcoinII.conf
	echo "[*] Getting RPC credentials from ${DAEMON_CONF}"
	if [ -f "${DAEMON_CONF}" ]; then
		RPC_USER=$(grep 'rpcuser=' "${DAEMON_CONF}"|cut -d = -f2|head -1)
		RPC_PASS=$(grep 'rpcpassword=' "${DAEMON_CONF}"|cut -d = -f2|head -1)
	fi

	# Fallback to cookie file if no user/pass in config
	COOKIE_FILE="${DAEMON_DIR}/.cookie"
	if [ -z "${RPC_USER}" ] && [ -f "${COOKIE_FILE}" ]; then
		echo "[*] Using cookie file for authentication"
		COOKIE_AUTH="--cookie-file ${COOKIE_FILE}"
	else
		COOKIE_AUTH="--cookie ${RPC_USER}:${RPC_PASS}"
	fi

	# Generate popular scripts if they don't exist
	if [ ! -e "${POPULAR_SCRIPTS_FILE}" ];then
		echo "[*] Popular scripts file not found, generating..."
		generate_popular_scripts
	fi

	# Build electrs arguments
	ELECTRS_ARGS=(
		--network "${NETWORK}"
		--daemon-dir "${DAEMON_DIR}"
		--db-dir "${DB_FOLDER}"
		--main-loop-delay "${MAIN_LOOP_DELAY}"
		--http-socket-file "${HTTP_SOCKET_FILE}"
		--cors '*'
		--address-search
		--utxos-limit "${UTXOS_LIMIT}"
		--electrum-txs-limit "${ELECTRUM_TXS_LIMIT}"
		-vv
	)

	# Add RPC socket if specified
	if [ -n "${RPC_SOCKET_FILE}" ]; then
		ELECTRS_ARGS+=(--rpc-socket-file "${RPC_SOCKET_FILE}")
	fi

	# Add popular scripts if file exists
	if [ -f "${POPULAR_SCRIPTS_FILE}" ]; then
		ELECTRS_ARGS+=(
			--precache-scripts "${POPULAR_SCRIPTS_FILE}"
			--precache-threads "${THREADS}"
		)
	fi

	# Run electrs
	echo "[*] Starting electrs for BitcoinII ${NETWORK}..."
	echo "[*] DB Directory: ${DB_FOLDER}"
	echo "[*] Daemon Directory: ${DAEMON_DIR}"
	echo "[*] Threads: ${THREADS}"
	
	cargo run \
		--release \
		--bin electrs \
		--features "${FEATURES}" \
		-- \
		"${ELECTRS_ARGS[@]}" \
		${COOKIE_AUTH}

	echo "[!] electrs exited, restarting in 5 seconds..."
	sleep 5
done
